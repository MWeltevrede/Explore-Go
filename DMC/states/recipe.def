# Header
Bootstrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04

%environment
	export BASH_ENV=/opt/bashrc
	export PATH="/opt/miniconda3/bin:$PATH"
    export MJLIB_PATH="/root/.mujoco/mujoco200_linux/bin/libmujoco200.so"
    export MJKEY_PATH="/root/.mujoco/mjkey.txt"

%files
	environment.yml /
    ~/.mujoco /root/.mujoco

%post
    apt-get update # update system
    apt-get install -y git   # install git
	apt-get install -y wget
    apt-get install -y xvfb xserver-xephyr tigervnc-standalone-server x11-utils gnumeric
    apt-get install -y libglfw3 libglew2.2 libc6
    apt-get install -y libgl1-mesa-dev libosmesa6-dev

    #for rendering
    apt-cache search mesa
    apt-get update && apt-get install -y libgl1-mesa-glx libosmesa6
    apt-get install -y libglew-dev

    mkdir -p /opt/miniconda3
   	wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /opt/miniconda3/miniconda.sh
	bash /opt/miniconda3/miniconda.sh -b -u -p /opt/miniconda3
	rm -rf /opt/miniconda3/miniconda.sh
	export PATH="/opt/miniconda3/bin:$PATH"

	# Accept Anaconda Terms of Service non-interactively
    /opt/miniconda3/bin/conda config --set plugins.auto_accept_tos yes
    /opt/miniconda3/bin/conda config --set anaconda_anon_usage no # Still good practice to disable usage reporting

    conda env create -n foctowinner -f /environment.yml
	echo -e "#! /bin/bash\n\n# script to activate the conda environment" > ~/.bashrc \
    && conda init bash \
    && echo -e "\nconda activate foctowinner" >> ~/.bashrc \
	&& conda clean -ay \
	&& cp ~/.bashrc /opt/bashrc 
    export BASH_ENV=/opt/bashrc

    #more stuff for rendering...
    /bin/bash -c "conda install -y -c conda-forge mesalib"
    /bin/bash -c "conda install -y -c conda-forge libstdcxx-ng=12"
    
    /bin/bash -c "pip install gym==0.21.0"
    /bin/bash -c "pip uninstall dm_control"
    /bin/bash -c "pip install dm_control@git+https://github.com/MWeltevrede/contextual-dmcontrol@fix/numpy_compat#subdirectory=cdmc/env/dm_control"
    /bin/bash -c "pip install dmc2gym@git+https://github.com/MWeltevrede/contextual-dmcontrol@fix/numpy_compat#subdirectory=cdmc/env/dmc2gym"
    /bin/bash -c "pip install cdmc@git+https://github.com/MWeltevrede/contextual-dmcontrol@27efa4f45cac838b565494ff87c1c9083a1faf93"
    /bin/bash -c "pip install tensorboard shimmy==0.2.1"
    /bin/bash -c "pip install PyOpenGL==3.1.0"
    /bin/bash -c "pip install pyrender"
    /bin/bash -c "pip install stable_baselines3@git+https://github.com/MWeltevrede/stable-baselines3@2ff271a80b669dfe1091960e5392a5a26b11037f"
    